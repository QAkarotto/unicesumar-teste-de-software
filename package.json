{
  "name": "unicesumar-teste-de-software",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados de API e Web do ServeRest com Playwright e TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:web": "playwright test --project=web --pass-with-no-tests",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
