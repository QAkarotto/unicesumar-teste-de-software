{
  "name": "unicesumar-teste-de-software",
  "version": "1.0.0",
  "description": "Testes automatizados com Playwright (API do ServeRest e, futuramente, Web)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:web": "playwright test --project=web",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
